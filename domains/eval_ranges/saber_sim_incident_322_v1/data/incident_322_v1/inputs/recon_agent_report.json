  "attack_paths": [
    {
      "stage": "Initial Access",
      "mitre_id": "T1566.001",
      "mitre_name": "Phishing: Spearphishing Attachment",
      "description": "A threat actor targets an employee (jsmith) at AlpineSkiHouse with a spearphishing\nemail containing a malicious document attachment delivered via Exchange Online. Upon\nopening the attachment on workstation ASH-WS01, the embedded payload executes and\nestablishes a command-and-control beacon that communicates through an HTTP proxy,\nproviding persistent remote access to the compromised endpoint."
    },
    {
      "stage": "Command and Control",
      "mitre_id": "T1071.001",
      "mitre_name": "Application Layer Protocol: Web Protocols",
      "description": "Operating through the C2 channel, the attacker discovers a cached Azure session\n(browser tokens or Azure CLI token cache) on ASH-WS01 and leverages it to enumerate\nARM resources \u2014 listing subscriptions, resource groups, and compute quotas to map\nthe organization's cloud infrastructure and identify cryptomining targets."
    },
    {
      "stage": "Discovery",
      "mitre_id": "T1580",
      "mitre_name": "Cloud Infrastructure Discovery",
