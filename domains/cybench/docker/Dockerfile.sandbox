# SABER Sandbox for Cybench Domain
# Extends the minimal SABER sandbox base with essential cybersecurity tools
# saber passes the selected base variant (react-only vs agent-CLI image).
ARG SABER_BASE_IMAGE=saber/sandbox:latest
FROM ${SABER_BASE_IMAGE}

# Switch to root to install packages
USER root

# Install essential cybersecurity tools for web application testing
# (jq, git, curl, wget already in base image)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        # Directory/file enumeration tools
        gobuster \
        dirb \
        # Network tools
        nmap \
        netcat-openbsd \
        socat \
        # File analysis tools
        file \
        binutils \
        xxd \
        # Additional network utilities
        dnsutils \
        telnet \
        # Archive tools
        unzip \
        zip \
        # Build tools for compiling payloads if needed
        gcc \
        make \
        # Editors
        nano \
        vim \
        && rm -rf /var/lib/apt/lists/*

# Create wordlist directories and download common wordlists
RUN mkdir -p /usr/share/wordlists/dirb && \
    mkdir -p /usr/share/wordlists/dirbuster && \
    # Download DIRB wordlists from the official source
    curl -s -o /usr/share/wordlists/dirb/common.txt \
        https://raw.githubusercontent.com/v0re/dirb/master/wordlists/common.txt && \
    curl -s -o /usr/share/wordlists/dirb/big.txt \
        https://raw.githubusercontent.com/v0re/dirb/master/wordlists/big.txt && \
    curl -s -o /usr/share/wordlists/dirb/small.txt \
        https://raw.githubusercontent.com/v0re/dirb/master/wordlists/small.txt && \
    # Download DirBuster wordlists
    curl -s -o /usr/share/wordlists/dirbuster/directory-list-2.3-medium.txt \
        https://raw.githubusercontent.com/daviddias/node-dirbuster/master/lists/directory-list-2.3-medium.txt && \
    # Verify the main wordlist exists
    test -f /usr/share/wordlists/dirb/common.txt || echo "ERROR: Failed to download wordlists"

# Install additional Python packages for cybersecurity tasks.
# Installs from PyPI so builds always pick up the latest versions. Where
# files.pythonhosted.org is blocked to container traffic, run
# docker/fetch_wheels.sh on the host first and the build falls back to those
# wheels (not committed - they go stale and bloat the repo).
# (requests already in base image)
# saber builds domain images with the domain root as context, so this path
# is relative to the domain directory, not to docker/.
COPY docker/wheels/ /tmp/wheels/
RUN PKGS='beautifulsoup4 urllib3 pycryptodome'; \
    uv pip install --system --no-cache $PKGS \
    || { echo "PyPI unreachable - falling back to docker/wheels/ (populate it on a host with PyPI access via docker/fetch_wheels.sh)"; \
         uv pip install --system --no-cache --no-index --find-links=/tmp/wheels $PKGS; } \
    && rm -rf /tmp/wheels

# Set environment variables for cybersecurity tools
# IMPORTANT: /usr/local/bin MUST come before /usr/bin so that the base image's
# Python 3.11 (with copilot, claude-code-sdk, etc.) is used instead of the
# system Python 3.13 installed as an apt dependency.
ENV PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"
